# Zalo bridge
BRIDGE_PORT=3099
INTERNAL_SECRET=<shared secret with agent-ops>
AGENT_OPS_URL=http://agent-ops:3000
ALLOWED_GROUP_IDS=<comma-separated Zalo group IDs>
GROUP_CANCELED_ORDER=<comma-separated group IDs to notify on order cancel>

# Zalo session (in-memory + file persistence)
ZALO_SESSION_FILE=./data/zalo-session.json
ZALO_QR_PATH=./data/qr.png
ZALO_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
ZALO_COOKIE_REFRESH_INTERVAL_MS=1800000
